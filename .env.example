# Server-side only. Read by the api container; never reaches the app bundle.
TYPESAFE_API_KEY=

# Set to 1 when a reverse proxy sits in front, so rate limits key off the real
# client ip rather than the proxy's. Leave unset when the server is reached directly.
TRUST_PROXY=

# Base url of the server above, baked into the app bundle at build time, so it
# must be a public url. Local dev: http://localhost:8788
VITE_API_URL=https://example.com
